<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="FTL" path="third_party/freetype2/include/freetype-android.*" desc="" />
                <policyitem type="compatibility" name="FTL" path="third_party/freetype2/include/freetype-no-type1/ftoption.h" desc="" />
                <policyitem type="compatibility" name="PublicDomainLicense" path="tools/sk_app/unix.*" desc="" />
                <policyitem type="compatibility" name="Khronos" path="src/sksl.*" desc="" />
                <policyitem type="compatibility" name="Google" path="gm.*" desc="" />
                <policyitem type="compatibility" name="Google1" path="gm.*" desc="" />
                <policyitem type="compatibility" name="Google2" path="gm.*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="third_party/llvm-10.0/llvm/include/llvm/Support/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Tools/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/bloat/README.chromium"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-10.0/Android.bp"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Headers/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name=".*chromium"
                    desc="" />
                <filteritem type="filepath" name="bin/compare"
                    desc="" />
                <filteritem type="filepath" name="tools/doxygen/mainpage/mainpage.dox"
                    desc="" />
                <filteritem type="filepath" name="third_party/etc1/README.google"
                    desc="" />
                </filefilter>
                <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter> 
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Google" desc="">
                <licensetext name="
                 * Copyright 2015 Google Inc.
            " desc="" />
            </licensematcher> 
            <licensematcher name="Google1" desc="">
                <licensetext name="
                 * Copyright 2016 Google Inc.
            " desc="" />
            </licensematcher> 
             <licensematcher name="Google2" desc="">
                <licensetext name="
                 * Copyright 2017 Google Inc.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>